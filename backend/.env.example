DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/codeatlas
FRONTEND_ORIGIN=http://localhost:3000
ENVIRONMENT=development
COOKIE_SECURE=false
# Set a Fernet key outside development; back it up to retain access to saved provider keys.
ENCRYPTION_KEY=
ALLOW_LOCAL_AI=true
AI_TIMEOUT_SECONDS=120
MAX_CONTEXT_CHARS=60000

# Optional server-configured provider, visible ONLY to the matching registered account.
# Leave the key empty to disable. Fill every field when enabling; never commit backend/.env.
DEFAULT_AI_PROVIDER_NAME=Groq
DEFAULT_AI_BASE_URL=https://api.groq.com/openai/v1
DEFAULT_AI_MODEL=openai/gpt-oss-120b
DEFAULT_AI_API_KEY=
DEFAULT_AI_OWNER_EMAIL=
# Register the owner first, then copy id from GET /api/auth/me. Both ID and email must match.
DEFAULT_AI_OWNER_ID=
